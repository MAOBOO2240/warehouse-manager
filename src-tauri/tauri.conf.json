{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "倉儲管理系統",
  "version": "1.0.0",
  "identifier": "tw.local.warehousemanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "倉儲管理系統",
        "width": 1280,
        "height": 850,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#8A8B8A"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}